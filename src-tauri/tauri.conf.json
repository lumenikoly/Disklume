{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClearMap",
  "version": "0.0.1",
  "identifier": "local.clearmap.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "ClearMap", "width": 1360, "height": 900, "minWidth": 960, "minHeight": 650, "backgroundColor": "#f4f7f1", "dragDropEnabled": false }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Локальная визуальная уборка файлов",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0" },
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["Russian", "English"] } }
  }
}
